+    value.outputOffset = params.outputOffset ?? 0;
+    value.auxOffset = params.auxOffset ?? 0;
+    value.aux2Offset = params.aux2Offset ?? 0;
+    value.tokenCount = params.tokenCount ?? 0;
+    value.inputDim = params.inputDim ?? 0;

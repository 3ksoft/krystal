{
  "name": "chomato",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:gui": "cd packages/gui && bunx vite",
    "build:schema": "cd packages/schema && bun run build",
    "build:bridge": "cd packages/bridge && bun run build",
    "build:webgpu": "cd packages/webgpu && bun run artifact:build",
    "build:native": "cd packages/backend && bun run compile:native-exe",
    "build": "bun run build:schema && bun run build:bridge && bun run build:webgpu",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "test": "bun test tests",
    "node:cleanup": "rm -rf $(fd --no-ignore tsconfig.tsbuildinfo) && rm -rf $(fd --no-ignore bun.lock) && rm -rf $(fd --no-ignore node_modules) && bun pm cache rm && bun i"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@ark/json-schema": "^0.0.7",
    "@sandblaster/core": "link:@sandblaster/core",
    "@schema-pop/schema": "link:@schema-pop/schema",
    "arktype": "2.2.3"
  }
}